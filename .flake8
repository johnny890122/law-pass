[flake8]
max-line-length = 150

# Suppress pervasive cosmetic noise from the existing codebase.
# W291/W293: trailing whitespace / blank line with whitespace
# E302/E303/E305: blank line counts around functions and classes
extend-ignore = W291, W293, W391, E302, E303, E305

per-file-ignores =
    # load_dotenv() must come before blueprint imports — E402 is intentional.
    app.py: E402
    # MONGO_URI must be set before app imports that trigger DB singleton init.
    tests/test_app.py: E402
    # Long logger.info lines in service layer.
    services/inventory.py: E501

exclude =
    .git,
    __pycache__,
    docs,
    knowledge,
    scripts,
    migrations
