# Local MongoDB URI (for development)
MONGO_URI=mongodb://localhost:27017/localdb

# Remote MongoDB URI (for production/remote database)
# Example: mongodb+srv://<username>:<password>@cluster0.example.mongodb.net/dbname?retryWrites=true&w=majority
REMOTE_MONGO_URI=mongodb+srv://<username>:<password>@cluster0.example.mongodb.net/patent-act?retryWrites=true&w=majority

# Server configuration
PORT=5000

# Flask debug mode
FLASK_DEBUG=False

# Set to "production" on Heroku so the session cookie is HTTPS-only.
# Leave unset locally: plain-http localhost would drop a Secure cookie.
# FLASK_ENV=production

# Flask secret key for session management (multi-user support)
# Generate a random key with: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=your_secret_key_here_generate_a_random_one_for_production

# Google sign-in (required; the app refuses to start without both).
# Google Cloud Console → Credentials → OAuth client ID → Web application.
# Authorized redirect URIs: http://localhost:5000/auth/google/callback
#                           http://localhost:5001/auth/google/callback (macOS AirPlay holds 5000)
#                           https://<app>.herokuapp.com/auth/google/callback
# Open the app at http://localhost:<port>, not 127.0.0.1, or Google rejects the redirect_uri.
GOOGLE_CLIENT_ID=your_client_id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your_client_secret

# LINE Login (required; the app refuses to start without both).
# LINE Developers Console → provider → LINE Login channel (Web app):
# "Channel ID" and "Channel secret". Never move the channel to another provider:
# LINE user IDs belong to the provider, so every LINE learner would become a new account.
# Callback URLs: http://localhost:5000/auth/line/callback
#                http://localhost:5001/auth/line/callback
#                https://<app>.herokuapp.com/auth/line/callback
LINE_CLIENT_ID=your_line_channel_id
LINE_CLIENT_SECRET=your_line_channel_secret

# OpenRouter (required for question generation and grading)
OPENROUTER_API_KEY=your_api_key_here

# Optional model overrides; services/llm_client.py holds the defaults shown.
# OPENROUTER_MODEL=anthropic/claude-sonnet-4.5
# OPENROUTER_GRADING_MODEL=anthropic/claude-3.5-haiku
